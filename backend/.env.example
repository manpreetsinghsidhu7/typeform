# FastAPI settings
# In development, you can use SQLite.
# For production (Render/Turso), set this to your libSQL/PostgreSQL connection string.
DATABASE_URL=sqlite:///./typeform.db

# Frontend URL for CORS (replace with Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# JWT Auth Settings
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
